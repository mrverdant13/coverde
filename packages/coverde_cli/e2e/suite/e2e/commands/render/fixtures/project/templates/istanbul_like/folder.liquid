{%- assign lo = thresholds["istanbul-lo"] -%}
{%- assign hi = thresholds["istanbul-hi"] -%}
{%- if root -%}
{%- assign node = root -%}
{%- assign title = "All files" -%}
{%- else -%}
{%- assign node = directory -%}
{%- assign title = node.path -%}
{%- endif -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Code coverage report for {{ title | escape }}</title>
  <link rel="stylesheet" href="{{ pathToRoot }}base.css">
</head>
<body>
  <div class="wrapper">
    <div class="pad1">
      <h1>{{ title | escape }}</h1>
      {%- if root == null -%}
      <div class="path quiet"><a href="{{ pathToRoot }}index.html">All files</a></div>
      {%- elsif node.path != "" -%}
      <div class="path quiet">{{ node.path | escape }}</div>
      {%- endif -%}
      <div class="clearfix">
        {% render 'templates/istanbul_like/metric.liquid', label: "Statements", rate: node.lineRate, hit: node.linesHit, found: node.linesFound %}
        {% render 'templates/istanbul_like/metric.liquid', label: "Branches", rate: node.branchRate, hit: node.branchesHit, found: node.branchesFound %}
        {% render 'templates/istanbul_like/metric.liquid', label: "Functions", rate: node.functionRate, hit: node.functionsHit, found: node.functionsFound %}
        {% render 'templates/istanbul_like/metric.liquid', label: "Lines", rate: node.lineRate, hit: node.linesHit, found: node.linesFound %}
      </div>
    </div>
    <div class="status-line {% render 'templates/istanbul_like/level.liquid', rate: node.lineRate, lo: lo, hi: hi %}"></div>
    <div class="pad1">
      <table class="coverage-summary">
        <thead>
          <tr>
            <th class="file">File</th>
            <th class="pic"></th>
            <th class="pct">Statements</th>
            <th class="abs"></th>
            <th class="pct">Branches</th>
            <th class="abs"></th>
            <th class="pct">Functions</th>
            <th class="abs"></th>
            <th class="pct">Lines</th>
            <th class="abs"></th>
          </tr>
        </thead>
        <tbody>
          {%- for child in node.directories -%}
          {% render 'templates/istanbul_like/row.liquid', label: child.name, href: child.outputPath, pathToRoot: pathToRoot, lineRate: child.lineRate, linesHit: child.linesHit, linesFound: child.linesFound, branchRate: child.branchRate, branchesHit: child.branchesHit, branchesFound: child.branchesFound, functionRate: child.functionRate, functionsHit: child.functionsHit, functionsFound: child.functionsFound, lo: lo, hi: hi %}
          {%- endfor -%}
          {%- for child in node.files -%}
          {% render 'templates/istanbul_like/row.liquid', label: child.name, href: child.outputPath, pathToRoot: pathToRoot, lineRate: child.lineRate, linesHit: child.linesHit, linesFound: child.linesFound, branchRate: child.branchRate, branchesHit: child.branchesHit, branchesFound: child.branchesFound, functionRate: child.functionRate, functionsHit: child.functionsHit, functionsFound: child.functionsFound, lo: lo, hi: hi %}
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    <div class="push"></div>
  </div>
  <div class="footer quiet pad2 space-top1 center small">
    Code coverage generated by
    <a href="https://github.com/mrverdant13/coverde">coverde</a>
     at 2024-06-15 12:30:00
  </div>
</body>
</html>
