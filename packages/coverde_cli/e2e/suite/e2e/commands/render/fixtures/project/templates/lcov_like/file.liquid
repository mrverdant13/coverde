{%- assign lo = thresholds["lcov-lo"] -%}
{%- assign hi = thresholds["lcov-hi"] -%}
{%- if file.testName -%}
{%- assign testLabel = file.testName -%}
{%- else -%}
{%- assign testCount = document.testNames | size -%}
{%- if testCount > 0 -%}
{%- assign testLabel = document.testNames | join: ", " -%}
{%- else -%}
{%- assign testLabel = "coverde" -%}
{%- endif -%}
{%- endif -%}
{%- assign date = "2024-06-15 12:30:00" -%}
{%- assign rel = file.path | report_path | split: "/" -%}
{%- assign relCount = rel | size -%}
{%- if relCount > 1 -%}
{%- assign dir = file.path | report_path | remove_last: file.name | remove_last: "/" -%}
{%- else -%}
{%- assign dir = "" -%}
{%- endif -%}
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">

<html lang="en">

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <title>LCOV - coverde - {{ file.path | report_path | escape }}</title>
  <link rel="stylesheet" type="text/css" href="{{ pathToRoot }}gcov.css">
</head>

<body>
{% render 'templates/lcov_like/header.liquid', pathToRoot: pathToRoot, kind: "file", rel: dir, name: file.name, testLabel: testLabel, date: date, lo: lo, hi: hi, lineRate: file.lineRate, linesHit: file.linesHit, linesFound: file.linesFound, functionRate: file.functionRate, functionsHit: file.functionsHit, functionsFound: file.functionsFound, branchRate: file.branchRate, branchesHit: file.branchesHit, branchesFound: file.branchesFound %}

          <table cellpadding=0 cellspacing=0 border=0>
            <tr>
              <td><br></td>
            </tr>
            <tr>
              <td>
<pre class="sourceHeading">             Branch data     Line data    Source code</pre>
<pre class="source">
{%- for line in file.lines -%}
{%- assign missedBranch = false -%}
{%- assign branchCount = line.branches | size -%}
{%- for branch in line.branches -%}
{%- if branch.taken == null or branch.taken == 0 -%}
{%- assign missedBranch = true -%}
{%- endif -%}
{%- endfor -%}
{%- if line.hits == null and branchCount == 0 -%}
{%- assign hitText = "             " -%}
{%- assign hitClass = "" -%}
{%- elsif line.hits == null -%}
{%- if missedBranch -%}
{%- assign hitText = 0 | append: "" | pad: 12, "right" -%}
{%- assign hitClass = "tlaUNC" -%}
{%- else -%}
{%- assign hitText = "             " -%}
{%- assign hitClass = "" -%}
{%- endif -%}
{%- elsif line.hits == 0 -%}
{%- assign hitText = line.hits | append: "" | pad: 12, "right" -%}
{%- assign hitClass = "tlaUNC" -%}
{%- else -%}
{%- assign hitText = line.hits | append: "" | pad: 12, "right" -%}
{%- assign hitClass = "tlaGNC" -%}
{%- endif -%}
<span id="L{{ line.number }}"><span class="lineNum">{{ line.number | append: "" | pad: 8, "right" }}</span>{% if branchCount > 0 %}            [{% if missedBranch %}<span class="tlaUNC" title="Branch was not taken"> - </span>{% else %}<span class="tlaGBC" title="Branch was taken"> + </span>{% endif %}]{% else %}                 {% endif %}:{% if hitClass == "" %}{{ hitText }}: {{ line.source | escape }}{% else %}<span class="{{ hitClass }}">{{ hitText }} : {{ line.source | escape }}</span>{% endif %}</span>
{% endfor %}
</pre>
              </td>
            </tr>
          </table>
          <br>

          {%- if file.functions != null -%}
          <center>
          <table cellpadding=1 cellspacing=1 border=0 id="functions">
            <tr><td><br></td></tr>
            <tr>
              <td class="tableHead">Function Name <span class="tableHeadSort"><img src="{{ pathToRoot }}glass.png" width=10 height=14 alt="Sort by function name" title="Click to sort table by function name" border=0></span></td>
              <td class="tableHead">Hit count <span class="tableHeadSort"><img src="{{ pathToRoot }}updown.png" width=10 height=14 alt="Sort by function hit count" title="Click to sort table by function hit count" border=0></span></td>
            </tr>
            {%- for function in file.functions -%}
            <tr>
              <td class="coverFn"><a href="#L{{ function.line }}">{{ function.name | escape }}</a></td>
              <td class="{%- if function.hits > 0 -%}coverFnHi{%- else -%}coverFnLo{%- endif -%}">{{ function.hits }}</td>
            </tr>
            {%- endfor -%}
          </table>
          </center>
          <br>
          {%- endif -%}

          {%- if file.sourceAvailable == false -%}
          <p class="sourceHeading">Source file was not found.</p>
          {%- endif -%}

          <table width="100%" border=0 cellspacing=0 cellpadding=0>
            <tr><td class="ruler"><img src="{{ pathToRoot }}glass.png" width=3 height=3 alt=""></td></tr>
            <tr><td class="versionInfo">Generated by: <a href="https://github.com/mrverdant13/coverde">coverde</a></td></tr>
          </table>
          <br>

</body>
</html>
