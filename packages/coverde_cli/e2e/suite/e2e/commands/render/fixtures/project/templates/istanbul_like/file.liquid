{%- assign lo = thresholds["istanbul-lo"] -%}
{%- assign hi = thresholds["istanbul-hi"] -%}
{%- if file.path == file.name -%}
{%- assign dir = "" -%}
{%- else -%}
{%- assign suffix = "/" | append: file.name -%}
{%- assign dir = file.path | remove_last: suffix -%}
{%- endif -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Code coverage report for {{ file.path | escape }}</title>
  <link rel="stylesheet" href="{{ pathToRoot }}base.css">
</head>
<body>
  <div class="wrapper">
    <div class="pad1">
      <h1>{{ file.name | escape }}</h1>
      <div class="path quiet">
        <a href="{{ pathToRoot }}index.html">All files</a>
        {%- if dir != "" %} / <a href="index.html">{{ dir | escape }}</a>{%- endif -%}
      </div>
      <div class="clearfix">
        {% render 'templates/istanbul_like/metric.liquid', label: "Statements", rate: file.lineRate, hit: file.linesHit, found: file.linesFound %}
        {% render 'templates/istanbul_like/metric.liquid', label: "Branches", rate: file.branchRate, hit: file.branchesHit, found: file.branchesFound %}
        {% render 'templates/istanbul_like/metric.liquid', label: "Functions", rate: file.functionRate, hit: file.functionsHit, found: file.functionsFound %}
        {% render 'templates/istanbul_like/metric.liquid', label: "Lines", rate: file.lineRate, hit: file.linesHit, found: file.linesFound %}
      </div>
    </div>
    <div class="status-line {% render 'templates/istanbul_like/level.liquid', rate: file.lineRate, lo: lo, hi: hi %}"></div>
    {%- if file.functions != null -%}
    <div class="pad1">
      <table class="coverage-summary">
        <thead>
          <tr>
            <th class="file">Function</th>
            <th class="pct">Line</th>
            <th class="abs">Hits</th>
          </tr>
        </thead>
        <tbody>
          {%- for function in file.functions -%}
          <tr>
            <td class="file">{{ function.name | escape }}</td>
            <td class="pct">{{ function.line }}</td>
            <td class="abs">{{ function.hits }}</td>
          </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- endif -%}
    {%- if file.sourceAvailable == false -%}
    <div class="pad1 quiet">Source file was not found.</div>
    {%- endif -%}
    <div class="pad1">
      <table class="coverage">
        <tr>
          <td class="line-count quiet">{%- for line in file.lines -%}
<a name="L{{ line.number }}"></a><a href="#L{{ line.number }}">{{ line.number }}</a>
{% endfor -%}</td>
          <td class="line-coverage quiet">{%- for line in file.lines -%}
{%- assign missedBranch = false -%}
{%- for branch in line.branches -%}
{%- if branch.taken == null or branch.taken == 0 -%}
{%- assign missedBranch = true -%}
{%- endif -%}
{%- endfor -%}
{%- if line.hits == null -%}<span class="cline-any cline-neutral">&nbsp;</span>{%- elsif line.hits > 0 and missedBranch -%}<span class="cline-any cbranch-no">{{ line.hits }}×</span>{%- elsif line.hits > 0 -%}<span class="cline-any cline-yes">{{ line.hits }}×</span>{%- else -%}<span class="cline-any cline-no">&nbsp;</span>{%- endif %}
{% endfor -%}</td>
          <td class="text"><pre class="prettyprint lang-dart">{%- for line in file.lines -%}
{{ line.source | escape }}
{% endfor -%}</pre></td>
        </tr>
      </table>
    </div>
    <div class="push"></div>
  </div>
  <div class="footer quiet pad2 space-top1 center small">
    Code coverage generated by
    <a href="https://github.com/mrverdant13/coverde">coverde</a>
     at 2024-06-15 12:30:00
  </div>
</body>
</html>
